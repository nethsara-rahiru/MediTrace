{
  "expo": {
    "name": "MedTrace",
    "slug": "medtrace",
    "scheme": "medtrace",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lk.medtrace.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan medicine packaging to find locally stored product information."
      }
    },
    "android": {
      "package": "lk.medtrace.app",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#E8F3EE"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MedTrace to scan medicine packaging.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F6F8FA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
